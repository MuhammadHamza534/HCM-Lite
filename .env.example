# API runtime
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Supply a real PostgreSQL connection locally; this placeholder is intentionally unusable.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/hcm_lite?schema=public
# Required when protected routes are added in Phase 2. Never use this example value in production.
JWT_SECRET=replace-with-a-long-random-secret

# Reserved for later phases. Do not place real provider credentials in this file.
ADMIN_EMAIL=
ADMIN_PASSWORD=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Frontend public configuration; this must never contain secrets.
VITE_API_BASE_URL=http://localhost:4000
